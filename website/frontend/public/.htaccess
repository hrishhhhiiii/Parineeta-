# Apache / LiteSpeed (Hostinger). Mirrors public/_headers; Cloudflare Pages ignores this file.
Options -Indexes
DirectoryIndex index.html
RewriteEngine On
RewriteRule ^admin/?$ admin.html [L]
RewriteRule ^(account|track)/?$ account.html [L]
RewriteRule ^login/?$ login.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  <If "%{REQUEST_URI} =~ m#^/(admin|account|track|login)#">
    Header always set X-Robots-Tag "noindex"
    Header always set Cache-Control "no-store"
  </If>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

ErrorDocument 404 /index.html
